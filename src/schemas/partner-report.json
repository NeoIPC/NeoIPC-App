{
  "fields": [
    {
      "name": "referenceDataFile",
      "type": "character"
    },
    {
      "name": "unitCodes",
      "type": "character[]",
      "description": "Department codes (NeoIPC site codes) to include in this report.\nMultiple codes are aggregated into one combined render; the\nsubtitle lists them, comma-separated."
    },
    {
      "name": "reportingPeriodFrom",
      "type": "Date",
      "description": "Start of the reporting period (inclusive)."
    },
    {
      "name": "reportingPeriodTo",
      "type": "Date",
      "description": "End of the reporting period (inclusive)."
    },
    {
      "name": "birthWeightFrom",
      "type": "integer",
      "min": "0",
      "max": "65535",
      "description": "Lower bound (inclusive) of the birth-weight filter, in grams."
    },
    {
      "name": "birthWeightTo",
      "type": "integer",
      "min": "0",
      "max": "65535",
      "description": "Upper bound (inclusive) of the birth-weight filter, in grams."
    },
    {
      "name": "gestationalAgeFrom",
      "type": "integer",
      "min": "0",
      "max": "52",
      "description": "Lower bound (inclusive) of the gestational-age filter, in weeks."
    },
    {
      "name": "gestationalAgeTo",
      "type": "integer",
      "min": "0",
      "max": "52",
      "description": "Upper bound (inclusive) of the gestational-age filter, in weeks."
    },
    {
      "name": "includeNonCorePatients",
      "type": "logical",
      "description": "Include patients not in the surveillance core cohort."
    },
    {
      "name": "includeTestData",
      "type": "logical",
      "default": "false",
      "description": "Include departments flagged as test units."
    },
    {
      "name": "sparseDataThreshold",
      "type": "integer",
      "default": "16",
      "min": "1",
      "description": "Threshold for sparse-data handling."
    },
    {
      "name": "confidenceIntervals",
      "type": "character",
      "default": "rate",
      "values": [
        "all",
        "rate",
        "none"
      ],
      "description": "Confidence-interval display mode."
    },
    {
      "name": "includeIntroductionTexts",
      "type": "logical",
      "default": "true",
      "description": "Include report-section introduction texts."
    },
    {
      "name": "includeMethodsTexts",
      "type": "logical",
      "default": "true",
      "description": "Include report-section methods texts."
    },
    {
      "name": "includeOutlierInterpretation",
      "type": "logical",
      "default": "false",
      "description": "Include outlier-interpretation prose alongside outlier callouts."
    },
    {
      "name": "includeValidationSummaryTable",
      "type": "logical",
      "default": "true",
      "description": "Include the data-validation summary table."
    },
    {
      "name": "includeBirthWeightFigure",
      "type": "logical",
      "default": "true",
      "description": "Include the birth-weight distribution figure."
    },
    {
      "name": "includeGestationalAgeFigure",
      "type": "logical",
      "default": "true",
      "description": "Include the gestational-age distribution figure."
    },
    {
      "name": "includeIncidenceDensityTable",
      "type": "logical",
      "default": "true",
      "description": "Include the incidence-density table."
    },
    {
      "name": "includeDeviceAssociatedIncidenceDensityTable",
      "type": "logical",
      "default": "true",
      "description": "Include the device-associated incidence-density table."
    },
    {
      "name": "includeAgentPerInfectionRateTable",
      "type": "logical",
      "default": "true",
      "description": "Include the agent-per-infection rate table."
    },
    {
      "name": "includeInfectiousAgentDetectionRateTable",
      "type": "logical",
      "default": "true",
      "description": "Include the infectious-agent-detection rate table."
    },
    {
      "name": "includeRiskDensityRateTable",
      "type": "logical",
      "default": "true",
      "description": "Include the risk-density rate table."
    },
    {
      "name": "includeAntibioticUtilisationTable",
      "type": "logical",
      "default": "false",
      "description": "Include the antibiotic-utilisation table."
    },
    {
      "name": "includeSurgicalProcedureRateTable",
      "type": "logical",
      "default": "true",
      "description": "Include the surgical-procedure rate table."
    },
    {
      "name": "includeResistantPathogenInfectionRateTable",
      "type": "logical",
      "default": "false",
      "description": "Include the resistant-pathogen-infection rate table."
    },
    {
      "name": "includeOrganismResistanceRateTable",
      "type": "logical",
      "default": "false",
      "description": "Include the organism-resistance rate table."
    },
    {
      "name": "includeAntibioticResistanceTestRateTable",
      "type": "logical",
      "default": "false",
      "description": "Include the antibiotic-resistance-test rate table."
    },
    {
      "name": "includeSecondaryBsiRateTable",
      "type": "logical",
      "default": "false",
      "description": "Include the secondary-BSI rate table."
    }
  ]
}